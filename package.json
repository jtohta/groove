{
  "name": "groove",
  "version": "0.1.0",
  "description": "FSM-based agentic coding runtime",
  "bin": {
    "groove": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "test": "jest",
    "lint": "eslint src tests",
    "format": "prettier --write src tests",
    "format:check": "prettier --check src tests",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,json,md}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "latest",
    "commander": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "latest",
    "@types/nock": "^10.0.3",
    "@types/node": "latest",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jest": "latest",
    "lint-staged": "^17.0.7",
    "nock": "^14.0.15",
    "prettier": "^3.8.3",
    "ts-jest": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "typescript-eslint": "^8.60.0"
  }
}
